# ─────────────────────────────────────────────────────────────
# IncendiosES — Variables de entorno
# Copia este archivo a .env (NO subas .env a git)
# En Vercel: añade cada variable en Settings > Environment Variables
# ─────────────────────────────────────────────────────────────

# FIRMS API key — registro gratuito en:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Sin esta key, /api/focos devuelve error 503 claro (no datos falsos).
FIRMS_MAP_KEY=tu_map_key_aqui

# Vercel Postgres (Neon) — se genera automáticamente al crear la DB en el Dashboard de Vercel.
# Sin esta variable, la detección de "focos nuevos" queda desactivada (no falla, simplemente
# todos los focos son tratados como no-marcados).
POSTGRES_URL=postgres://usuario:contraseña@host/db?sslmode=require

# Caché en memoria de la Function (en minutos).
# Si no se define, el valor por defecto es 15 minutos.
CACHE_TTL_MINUTES=15

# ─────────────────────────────────────────────────────────────
# Para desarrollo local, instala Vercel CLI y ejecuta:
#   npm i -g vercel
#   vercel dev
# Esto lee automáticamente el .env del proyecto.
# ─────────────────────────────────────────────────────────────
